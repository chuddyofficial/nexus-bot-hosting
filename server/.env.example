# === Nexus Bot Hosting - server environment ===

# Server
PORT=4000
NODE_ENV=production
PUBLIC_DOMAIN=bot.chnexus.net
CLIENT_ORIGIN=https://bot.chnexus.net

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Paths (absolute paths on the VPS)
DATA_DIR=./data
BOTS_DIR=../bots

# Resend (email) - https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Nexus Bot Hosting <noreply@chnexus.net>

# Bot limits
MAX_BOTS_PER_USER=5
MAX_UPLOAD_SIZE_MB=200

# Bot process runtime (bots run as native OS processes - see README's
# "Bot isolation model" section for why, and what this means for security)
# Override which python/node binary bots launch with, if not on default PATH
PYTHON_BIN=python
NODE_BIN=node
BOT_CPU_LIMIT=0.5
BOT_MEMORY_LIMIT_MB=256
# Ceilings a user can set for their own bot via the settings tab (per-bot override)
BOT_MAX_CPU_LIMIT=2
BOT_MAX_MEMORY_LIMIT_MB=1024

# SFTP (per-bot file access, e.g. via WinSCP)
SFTP_PORT=2222
# The host shown to users for SFTP connections. Cloudflare's proxy only forwards
# HTTP/HTTPS, so PUBLIC_DOMAIN will NOT work for SFTP if it's proxied (orange cloud) -
# set this to the VPS's real public IP, or a DNS-only (grey cloud) subdomain.
SFTP_HOST=
